# Configuración local para la práctica.
# 1. Copia este fichero:
#    cp .env.example .env
# 2. Añade una API key de https://ollama.com/settings/keys

OLLAMA_API_KEY=ollama_tu_clave_aqui
OLLAMA_MODEL=gpt-oss:120b
LLM_PROVIDER=ollama
# Ollama Cloud: https://ollama.com
# Ollama local: http://localhost:11434
OLLAMA_BASE_URL=https://ollama.com
# Runpod/vLLM/OpenAI-compatible: cambia LLM_PROVIDER=openai-compatible y rellena:
OPENAI_BASE_URL=
OPENAI_API_KEY=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DOCS_DIR=documentos-ejemplo
CHROMA_DIR=chroma_db

# Prompt que crearás manualmente en Langfuse Prompt Management durante la demo.
LANGFUSE_PROMPT_NAME=rag-basico
LANGFUSE_PROMPT_LABEL=production

# Configuración por defecto del modelo. La UI permite cambiarla en vivo.
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=900

# Langfuse local de la sesión: `cd 04-LLMOps-Langfuse && docker compose up -d`
# crea automáticamente un proyecto demo con estas claves.
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-sesion-04-demo
LANGFUSE_SECRET_KEY=lf-secret-sesion-04-demo
LANGFUSE_RELEASE=sesion-04-local
